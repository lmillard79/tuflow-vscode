{
  "comments": {
    "lineComment": "!"
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": {
      "pattern": "^\\s*(?:(?:else\\s+)?if\\b|else\\b)(?![^!#]*\\bend\\s+if\\b)[^!#\\r\\n]*(?:[!#].*)?$",
      "flags": "i"
    },
    "decreaseIndentPattern": {
      "pattern": "^\\s*(?:else(?:\\s+if)?|end\\s+if)\\b",
      "flags": "i"
    }
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*!.*$",
      "action": {
        "indent": "none",
        "appendText": "! "
      }
    },
    {
      "beforeText": "^\\s*#.*$",
      "action": {
        "indent": "none",
        "appendText": "# "
      }
    }
  ]
}
