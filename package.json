{
  "name": "tuflow-helper",
  "displayName": "TUFLOW Helper",
  "description": "Syntax highlighting and IntelliSense for TUFLOW files",
  "version": "0.8.2",
  "publisher": "lmillard79",
  "icon": "images/ico.png",
  "galleryBanner": {
    "color": "#2c3e50",
    "theme": "dark"
  },
  "homepage": "https://github.com/lmillard79/tuflow-vscode/blob/master/README.md",
  "bugs": {
    "url": "https://github.com/lmillard79/tuflow-vscode/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lmillard79/tuflow-vscode.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:tuflow"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "tuflow",
        "aliases": [
          "TUFLOW",
          "tuflow"
        ],
        "extensions": [
          ".tcf",
          ".ecf",
          ".tbc",
          ".tef",
          ".tgc",
          ".tmf",
          ".ebc",
          ".egf",
          ".rdf",
          ".trd",
          ".erd",
          ".elf",
          ".tlf",
          ".trfcf",
          ".trfc",
          ".toc",
          ".qcf",
          ".fvc",
          ".fvm",
          ".fvsed",
          ".fvptm",
          ".mcf",
          ".fvwq"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tuflow",
        "scopeName": "source.tuflow",
        "path": "./syntaxes/tuflow.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tuflow",
        "path": "./snippets/tuflow.json"
      }
    ],
    "commands": [
      {
        "command": "tuflow-helper.openDocumentation",
        "title": "Open Documentation",
        "category": "TUFLOW"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorTextFocus && editorLangId == tuflow",
          "command": "tuflow-helper.openDocumentation",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint \"src/**/*.ts\"",
    "pretest": "npm run compile && npm run lint",
    "test": "npm run test:unit && npm run test:extension",
    "test:unit": "node scripts/run-unit-tests.cjs",
    "test:extension": "vscode-test",
    "package:vsix": "vsce package --no-dependencies --out tuflow-helper.vsix && node scripts/verify-vsix.cjs tuflow-helper.vsix",
    "test:vsix": "vscode-test --config .vscode-test-installed.mjs",
    "test:fail-closed": "node scripts/verify-failure-propagation.cjs",
    "test:registration": "node --test test/language-registration.test.cjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "16.x",
    "@types/vscode": "1.74.0",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "eslint": "9.39.2",
    "typescript": "5.9.3"
  },
  "__metadata": {
    "id": "0805575c-1827-403e-9b99-d2f77f2c84a9",
    "publisherId": "724e0895-6846-4103-9c3b-04710b69098d",
    "publisherDisplayName": "lmillard79"
  },
  "overrides": {
    "minimatch@^3.1.2": {
      "brace-expansion": "1.1.22"
    },
    "mocha@^11.7.6": {
      "serialize-javascript": "7.1.4"
    }
  }
}
