{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TUFLOW",
  "scopeName": "source.tuflow",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#control-flow"
    },
    {
      "include": "#command-header"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#quoted-strings"
    },
    {
      "include": "#placeholders"
    },
    {
      "include": "#paths"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#values"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.exclamation.tuflow",
          "match": "!.*$"
        },
        {
          "name": "comment.line.number-sign.tuflow",
          "match": "#.*$"
        }
      ]
    },
    "control-flow": {
      "patterns": [
        {
          "name": "keyword.control.conditional.tuflow",
          "match": "(?i)^\\s*(?:else\\s+if(?:\\s+(?:scenario|event))?|end\\s+if|if(?:\\s+(?:scenario|event))?|else)\\b"
        }
      ]
    },
    "command-header": {
      "patterns": [
        {
          "name": "meta.command.header.tuflow",
          "begin": "^(?=\\s*[^!#=\\r\\n]+?\\s*==)",
          "end": "(?=\\s*==)|$",
          "patterns": [
            {
              "include": "#known-commands"
            },
            {
              "include": "#command-modifiers"
            }
          ]
        }
      ]
    },
    "known-commands": {
      "patterns": [
        {
          "name": "support.function.tuflow",
          "match": "(?i)^\\s*(?:Read\\s+GIS(?:\\s+(?:Z\\s+(?:Shape|Line|Point)|Mat|BC|HX|SX|WL|Node|Channel|Pipe))?|Write\\s+GIS(?:\\s+(?:Water\\s+Level|Velocity|Depth))?|Map\\s+Output\\s+(?:Format|Interval)|Geometry\\s+Control\\s+File\\s*\\(\\.tgc\\)|BC\\s+Control\\s+File\\s*\\(\\.tbc\\)|Cell\\s+Size|Set\\s+(?:Code|IWL|Mat|Grid|Origin|Extent)|Start\\s+Time|End\\s+Time|Start|Timestep|Output\\s+Interval|Write\\s+(?:Check\\s+Files|Results)|BC\\s+(?:Event|Database)|Define\\s+(?:Source|Event|BC)|Scenario|Event)(?=\\s*(?:\\|\\s*[^|!#=\\r\\n]+\\s*)*==)"
        }
      ]
    },
    "command-modifiers": {
      "patterns": [
        {
          "name": "keyword.operator.modifier.tuflow",
          "match": "\\|"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.tuflow",
          "match": "=="
        },
        {
          "name": "keyword.operator.layer.tuflow",
          "match": ">>"
        },
        {
          "name": "keyword.operator.separator.tuflow",
          "match": "\\|"
        }
      ]
    },
    "quoted-strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tuflow",
          "begin": "\"",
          "end": "\"|(?=$)",
          "patterns": [
            {
              "include": "#placeholders"
            }
          ]
        },
        {
          "name": "string.quoted.single.tuflow",
          "begin": "(?<!\\S)'|(?<===)'",
          "end": "'|(?=$)",
          "patterns": [
            {
              "include": "#placeholders"
            }
          ]
        }
      ]
    },
    "placeholders": {
      "patterns": [
        {
          "name": "variable.other.placeholder.tuflow",
          "match": "<<[^<>\\r\\n]+>>"
        }
      ]
    },
    "paths": {
      "patterns": [
        {
          "name": "string.unquoted.path.tuflow",
          "match": "(?i)(?<![\\w.])(?:(?:[A-Z]:|~|\\.\\.?)[\\\\\\/]|\\\\\\\\)[^\\r\\n!#\"'<>]*?\\.(?:tcf|tgc|tbc|tef|ecf|qcf|trfc|trd|tmf|shp|gpkg|tif|tiff|asc|flt|csv|ts1|ts2|nc|json|txt|dat|xyz)(?=\\b|[\\s>|!]|$)"
        },
        {
          "name": "string.unquoted.path.tuflow",
          "match": "(?i)(?<![\\w.])(?:(?:[A-Z]:|~|\\.\\.?)[\\\\\\/]|\\\\\\\\)[^\\s!#\"'<>]+"
        },
        {
          "name": "string.unquoted.path.tuflow",
          "match": "(?i)(?<![\\w.])(?:[\\w.-]+[\\\\\\/])*[\\w.-]+\\.(?:tcf|tgc|tbc|tef|ecf|qcf|trfc|trd|tmf|shp|gpkg|tif|tiff|asc|flt|csv|ts1|ts2|nc|json|txt|dat|xyz)(?![\\w.])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.tuflow",
          "match": "(?<![\\w./\\\\])[-+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][-+]?\\d+)?(?![\\w./\\\\])"
        }
      ]
    },
    "values": {
      "patterns": [
        {
          "name": "constant.language.tuflow",
          "match": "(?i)\\b(?:ON|OFF|AUTO|YES|NO|TRUE|FALSE)\\b"
        }
      ]
    }
  }
}
